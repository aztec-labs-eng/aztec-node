{
  "name": "@aztec-labs/sequencer-client",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dest/index.js",
    "./automine": "./dest/sequencer/automine/index.js",
    "./config": "./dest/config.js",
    "./test": "./dest/test/index.js"
  },
  "typedocOptions": {
    "entryPoints": [
      "./src/index.ts"
    ],
    "name": "Sequencer Client",
    "tsconfig": "./tsconfig.json"
  },
  "inherits": [
    "../package.common.json"
  ],
  "scripts": {
    "build": "yarn clean && ../scripts/tsc.sh",
    "build:dev": "../scripts/tsc.sh --watch",
    "clean": "rm -rf ./dest .tsbuildinfo",
    "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules ../node_modules/.bin/jest --passWithNoTests --maxWorkers=${JEST_MAX_WORKERS:-8}",
    "test:integration": "concurrently -k -s first -c reset,dim -n test,anvil \"yarn test:integration:run\" \"anvil\"",
    "test:integration:run": "NODE_NO_WARNINGS=1 node --experimental-vm-modules $(yarn bin jest) --no-cache --config jest.integration.config.json"
  },
  "dependencies": {
    "@aztec-labs/archiver": "workspace:^",
    "@aztec-labs/blob-client": "workspace:^",
    "@aztec-labs/blob-lib": "workspace:^",
    "@aztec-labs/constants": "workspace:^",
    "@aztec-labs/epoch-cache": "workspace:^",
    "@aztec-labs/ethereum": "workspace:^",
    "@aztec-labs/foundation": "workspace:^",
    "@aztec-labs/node-keystore": "workspace:^",
    "@aztec-labs/p2p": "workspace:^",
    "@aztec-labs/prover-client": "workspace:^",
    "@aztec-labs/simulator": "workspace:^",
    "@aztec-labs/slasher": "workspace:^",
    "@aztec-labs/stdlib": "workspace:^",
    "@aztec-labs/telemetry-client": "workspace:^",
    "@aztec-labs/validator-client": "workspace:^",
    "@aztec-labs/validator-ha-signer": "workspace:^",
    "@aztec/l1-artifacts": "0.1.0-dummy",
    "lodash.chunk": "^4.2.0",
    "tslib": "^2.4.0",
    "viem": "npm:@aztec/viem@2.38.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@aztec-labs/noir-protocol-circuits-types": "workspace:^",
    "@aztec-labs/protocol-contracts": "workspace:^",
    "@aztec-labs/world-state": "workspace:^",
    "@electric-sql/pglite": "^0.3.14",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash.chunk": "^4.2.7",
    "@types/lodash.pick": "^4.4.7",
    "@types/node": "^22.15.17",
    "@typescript/native-preview": "7.0.0-dev.20260113.1",
    "concurrently": "^7.6.0",
    "eslint": "^9.26.0",
    "express": "^4.21.2",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dest",
    "src",
    "!*.test.*"
  ],
  "types": "./dest/index.d.ts",
  "engines": {
    "node": ">=20.10"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "decoratorVersion": "2022-03"
            }
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.[cm]?js$": "$1"
    },
    "testRegex": "./src/.*\\.test\\.(js|mjs|ts)$",
    "rootDir": "./src",
    "reporters": [
      "default"
    ],
    "testTimeout": 120000,
    "setupFiles": [
      "../../foundation/src/jest/setup.mjs"
    ],
    "testEnvironment": "../../foundation/src/jest/env.mjs",
    "setupFilesAfterEnv": [
      "../../foundation/src/jest/setupAfterEnv.mjs"
    ]
  }
}
