{
  "name": "@aztec-labs/cli",
  "version": "0.32.0",
  "type": "module",
  "exports": {
    "./devnet": "./dest/cmds/devnet/index.js",
    "./infrastructure": "./dest/cmds/infrastructure/index.js",
    "./l1": "./dest/cmds/l1/index.js",
    "./l1/validators": "./dest/cmds/l1/update_l1_validators.js",
    "./aztec_node": "./dest/cmds/aztec_node/index.js",
    "./cli-utils": "./dest/utils/index.js",
    "./misc": "./dest/cmds/misc/index.js",
    "./validator_keys": "./dest/cmds/validator_keys/index.js",
    "./setup-contracts": "./dest/cmds/misc/setup_contracts.js",
    "./utils": "./dest/utils/index.js",
    "./inspect": "./dest/utils/inspect.js",
    "./config": "./dest/config/index.js",
    "./config/chain": "./dest/config/chain_l2_config.js",
    "./config/network": "./dest/config/network_config.js"
  },
  "typedocOptions": {
    "entryPoints": [
      "./dest/builder/index.js"
    ],
    "name": "Aztec CLI",
    "tsconfig": "./tsconfig.json"
  },
  "scripts": {
    "build": "yarn clean && ../scripts/tsc.sh",
    "build:dev": "../scripts/tsc.sh --watch",
    "clean": "rm -rf ./dest .tsbuildinfo",
    "copy-generated": "mkdir -p dest/config/generated/networks && cp src/config/generated/networks/*.json dest/config/generated/networks/",
    "generate": "./scripts/generate.sh",
    "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules ../node_modules/.bin/jest --passWithNoTests --maxWorkers=${JEST_MAX_WORKERS:-8}"
  },
  "inherits": [
    "../package.common.json",
    "./package.local.json"
  ],
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.[cm]?js$": "$1"
    },
    "testRegex": "./src/.*\\.test\\.(js|mjs|ts)$",
    "rootDir": "./src",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "decoratorVersion": "2022-03"
            }
          }
        }
      ]
    },
    "reporters": [
      "default"
    ],
    "testTimeout": 120000,
    "setupFiles": [
      "../../foundation/src/jest/setup.mjs"
    ],
    "testEnvironment": "../../foundation/src/jest/env.mjs",
    "setupFilesAfterEnv": [
      "../../foundation/src/jest/setupAfterEnv.mjs"
    ]
  },
  "dependencies": {
    "@aztec-labs/accounts": "workspace:^",
    "@aztec-labs/archiver": "workspace:^",
    "@aztec-labs/aztec.js": "workspace:^",
    "@aztec-labs/constants": "workspace:^",
    "@aztec-labs/ethereum": "workspace:^",
    "@aztec-labs/foundation": "workspace:^",
    "@aztec-labs/node-keystore": "workspace:^",
    "@aztec-labs/p2p": "workspace:^",
    "@aztec-labs/protocol-contracts": "workspace:^",
    "@aztec-labs/stdlib": "workspace:^",
    "@aztec-labs/wallets": "workspace:^",
    "@aztec-labs/world-state": "workspace:^",
    "@aztec/l1-artifacts": "0.1.0-dummy",
    "@ethersproject/wallet": "^5.8.0",
    "@iarna/toml": "^2.2.5",
    "@libp2p/peer-id-factory": "^3.0.4",
    "@scure/bip39": "^2.0.1",
    "commander": "^12.1.0",
    "lodash.chunk": "^4.2.0",
    "lodash.groupby": "^4.6.0",
    "semver": "^7.5.4",
    "source-map-support": "^0.5.21",
    "tslib": "^2.4.0",
    "viem": "npm:@aztec/viem@2.38.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash.chunk": "^4.2.9",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.startcase": "^4.4.7",
    "@types/node": "^22.15.17",
    "@types/semver": "^7.5.2",
    "@types/source-map-support": "^0.5.10",
    "@typescript/native-preview": "7.0.0-dev.20260113.1",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@aztec-labs/accounts": "workspace:^",
    "@aztec-labs/bb-prover": "workspace:^",
    "@aztec-labs/ethereum": "workspace:^",
    "@aztec-labs/noir-contracts.js": "workspace:^",
    "@aztec-labs/noir-protocol-circuits-types": "workspace:^",
    "@aztec-labs/noir-test-contracts.js": "workspace:^",
    "@aztec-labs/protocol-contracts": "workspace:^",
    "@aztec-labs/stdlib": "workspace:^",
    "@aztec/l1-artifacts": "0.1.0-dummy"
  },
  "files": [
    "dest",
    "src",
    "!*.test.*",
    "public_include_metric_prefixes.json"
  ],
  "types": "./dest/index.d.ts",
  "engines": {
    "node": ">=20.10"
  }
}
