# Create an image that installs yarn-projects production dependencies.
FROM aztecprotocol/build:3.1 AS build
# Copy files explicitly listed in Dockerfile.base.dockerignore into container.
# Should just be package.json, yarn.lock, and .yarn* files.
COPY . /usr/src
# Install yarn-project production dependencies.
# Explicitly specify projects that we use to keep as slim as possible.
WORKDIR /usr/src/yarn-project
# yarnrc carries the scope routing for a registry other than npmjs and names the credential
# variables it needs; the rest supply them. The credentials are secrets so they never reach a
# layer, and the yarnrc is one for a different reason: it lives in $HOME, and COPY and bind mounts
# read only from the build context. A run has one credential shape, so the other shape's secrets
# are simply absent, as all of them are in a public build where yarn's defaults are already right.
RUN --mount=type=secret,id=yarnrc,target=/root/.yarnrc.yml \
    --mount=type=secret,id=npmtoken \
    --mount=type=secret,id=npmuser \
    --mount=type=secret,id=npmpass \
    NPM_TOKEN="$(cat /run/secrets/npmtoken 2>/dev/null || true)" \
    NPM_USERNAME="$(cat /run/secrets/npmuser 2>/dev/null || true)" \
    NPM_PASSWORD="$(cat /run/secrets/npmpass 2>/dev/null || true)" \
    yarn workspaces focus @aztec-labs/aztec --production

# Create base of our final slim image.
# This can be cached and will only update if dependencies change.
FROM ubuntu:noble

RUN apt update && apt upgrade -y && apt install -y \
      curl \
      ca-certificates \
      git \
      jq \
      netcat-openbsd \
      parallel \
      libtcmalloc-minimal4t64 && \
      rm -rf /var/lib/apt/lists/*

# Node.js from the official release tarball. The checksums come from the release's SHASUMS256.txt,
# whose signature verifies against the Node.js release keys (github.com/nodejs/release-keys).
ENV NODE_VERSION=24.22.1
RUN case "$(dpkg --print-architecture)" in \
      amd64) arch=x64 sha256=eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c ;; \
      arm64) arch=arm64 sha256=33c37be234ba8bee041961047b19160f4d7d0f164e8e246f78bdd10feff148b3 ;; \
      *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac && \
    tarball=node-v$NODE_VERSION-linux-$arch.tar.gz && \
    curl -fsSLO https://nodejs.org/dist/v$NODE_VERSION/$tarball && \
    echo "$sha256  $tarball" | sha256sum -c - && \
    tar -xzf $tarball -C /usr/local --strip-components=1 --no-same-owner && \
    rm $tarball
# Install anvil.
COPY --from=build /opt/foundry/bin/anvil /opt/foundry/bin/anvil
COPY --from=build /opt/foundry/bin/forge /opt/foundry/bin/forge
COPY --from=build /opt/foundry/bin/cast /opt/foundry/bin/cast
ENV PATH="/opt/foundry/bin:$PATH" FOUNDRY_DISABLE_NIGHTLY_WARNING="1"
# Use tcmalloc for reduced memory fragmentation and improved allocation performance.
ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4"
# Copy in production dependencies.
COPY --from=build /usr/src/yarn-project/node_modules /usr/src/yarn-project/node_modules
# We install a symlink to yarn-project's node_modules at a location that all portalled packages can find as they
# walk up the tree as part of module resolution. The supposedly idiomatic way of supporting module resolution
# correctly for portalled packages, is to use --preserve-symlinks when running node.
# However I noticed --preserve-symlinks causes duplication of portalled instances such as bb.js, breaking the singleton
# logic by initializing the module more than once. So at present I don't see a viable alternative.
RUN ln -s /usr/src/yarn-project/node_modules /usr/src/node_modules
