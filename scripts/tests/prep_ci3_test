#!/usr/bin/env bash
# Tests scripts/prep_ci3.sh against a throwaway superproject whose ci3 submodule comes from a local
# repository, so no network is needed.
set -euo pipefail

prep_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/prep_ci3.sh"
bootstrap_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/bootstrap.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Local submodule urls are refused by default (protocol.file.allow); the script itself must not
# need any configuration, so allow it through the environment for every git call in this test.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
unset root ci3

fails=0
pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1${2:+ ($2)}"; fails=$((fails + 1)); }

# The "ci3" remote: two commits, so a pin can move.
git init -q --bare -b main "$work/ci3.git"
git -C "$work/ci3.git" config uploadpack.allowReachableSHA1InWant true
git clone -q "$work/ci3.git" "$work/ci3-src" 2>/dev/null
echo "v1" > "$work/ci3-src/source"
git -C "$work/ci3-src" add source && git -C "$work/ci3-src" commit -qm v1 && git -C "$work/ci3-src" push -q origin HEAD:main
c1=$(git -C "$work/ci3-src" rev-parse HEAD)
echo "v2" > "$work/ci3-src/source"
git -C "$work/ci3-src" commit -qam v2 && git -C "$work/ci3-src" push -q origin HEAD:main
c2=$(git -C "$work/ci3-src" rev-parse HEAD)

# The superproject: commit A has ci3 as a plain directory (before it became a submodule), B pins c1,
# C pins c2.
super_src="$work/super-src"
git init -q -b main "$super_src"
mkdir -p "$super_src/scripts" "$super_src/ci3"
cp "$prep_src" "$super_src/scripts/prep_ci3.sh"
cp "$bootstrap_src" "$super_src/bootstrap.sh"
echo "in-tree" > "$super_src/ci3/source"
git -C "$super_src" add -A && git -C "$super_src" commit -qm A
git -C "$super_src" rm -rq ci3
git -C "$super_src" submodule add -q "file://$work/ci3.git" ci3 2>/dev/null
git -C "$super_src/ci3" checkout -q "$c1"
git -C "$super_src" add ci3 && git -C "$super_src" commit -qm B
git -C "$super_src/ci3" checkout -q "$c2"
git -C "$super_src" add ci3 && git -C "$super_src" commit -qm C
git -C "$super_src" tag A HEAD~2 && git -C "$super_src" tag B HEAD~1 && git -C "$super_src" tag C HEAD

# A fresh clone of the superproject at a given commit, without submodules: what a developer gets.
function clone_at {
  local dir="$work/$1"
  git clone -q --no-recurse-submodules "$super_src" "$dir"
  git -C "$dir" checkout -q "$2"
  echo "$dir"
}
ci3_head() { git -C "$1/ci3" rev-parse HEAD; }

# Missing: a fresh clone gets ci3 at the pin. Nothing may go to stdout: entry points run inside
# pipelines whose stdout is data (bootstrap.sh test_cmds).
d=$(clone_at missing C)
out=$("$d/scripts/prep_ci3.sh" 2>/dev/null)
if [ "$(ci3_head "$d")" = "$c2" ] && [ "$(cat "$d/ci3/source")" = v2 ] && [ -z "$out" ]; then
  pass "missing submodule is initialised at the pin, nothing on stdout"
else
  fail "missing submodule is initialised at the pin, nothing on stdout" "head=$(ci3_head "$d" 2>&1) stdout='$out'"
fi

# At the pin: nothing to do, silently, and without the remote.
mv "$work/ci3.git" "$work/ci3.git.away"
err=$("$d/scripts/prep_ci3.sh" 2>&1 >/dev/null) && rc=0 || rc=$?
mv "$work/ci3.git.away" "$work/ci3.git"
[ $rc -eq 0 ] && [ -z "$err" ] && pass "at the pin: silent no-op that needs no network" \
  || fail "at the pin: silent no-op that needs no network" "rc=$rc err='$err'"

# Stale and clean: after a pull moves the pin, ci3 follows.
d=$(clone_at stale B)
"$d/scripts/prep_ci3.sh" 2>/dev/null
git -C "$d" checkout -q C
"$d/scripts/prep_ci3.sh" 2>/dev/null
[ "$(ci3_head "$d")" = "$c2" ] && pass "stale clean checkout is moved to the new pin" \
  || fail "stale clean checkout is moved to the new pin" "head=$(ci3_head "$d")"

# Stale with local changes: left alone, with a warning.
d=$(clone_at dirty B)
"$d/scripts/prep_ci3.sh" 2>/dev/null
git -C "$d" checkout -q C
echo "local edit" > "$d/ci3/source"
err=$("$d/scripts/prep_ci3.sh" 2>&1 >/dev/null) && rc=0 || rc=$?
if [ $rc -eq 0 ] && [ "$(ci3_head "$d")" = "$c1" ] && [ "$(cat "$d/ci3/source")" = "local edit" ] && [[ "$err" == *warning* ]]; then
  pass "stale checkout with local changes is left alone, with a warning"
else
  fail "stale checkout with local changes is left alone, with a warning" "rc=$rc head=$(ci3_head "$d") err='$err'"
fi

# Stale on a branch: someone working on ci3 in place. Left alone, with a warning.
d=$(clone_at branch B)
"$d/scripts/prep_ci3.sh" 2>/dev/null
git -C "$d" checkout -q C
git -C "$d/ci3" checkout -q -b my-ci3-work
err=$("$d/scripts/prep_ci3.sh" 2>&1 >/dev/null) && rc=0 || rc=$?
if [ $rc -eq 0 ] && [ "$(git -C "$d/ci3" symbolic-ref --short HEAD)" = my-ci3-work ] && [[ "$err" == *warning* ]]; then
  pass "stale checkout on a branch is left alone, with a warning"
else
  fail "stale checkout on a branch is left alone, with a warning" "rc=$rc err='$err'"
fi

# A ref from before ci3 was a submodule: nothing to do.
d=$(clone_at old A)
"$d/scripts/prep_ci3.sh" 2>/dev/null && [ "$(cat "$d/ci3/source")" = in-tree ] \
  && pass "ref where ci3 is a plain directory: no-op" || fail "ref where ci3 is a plain directory: no-op"

# Leftovers from a pre-submodule checkout block the init: fail clearly, touch nothing.
d=$(clone_at leftovers C)
mkdir -p "$d/ci3/__pycache__" && echo x > "$d/ci3/__pycache__/stale.pyc"
err=$("$d/scripts/prep_ci3.sh" 2>&1 >/dev/null) && rc=0 || rc=$?
if [ $rc -ne 0 ] && [ -f "$d/ci3/__pycache__/stale.pyc" ] && [[ "$err" == *"not empty"* ]]; then
  pass "leftover files in ci3/ fail with an explanation and are kept"
else
  fail "leftover files in ci3/ fail with an explanation and are kept" "rc=$rc err='$err'"
fi

# Many entry points starting at once on a fresh clone.
d=$(clone_at parallel C)
pids=()
for _ in $(seq 8); do "$d/scripts/prep_ci3.sh" 2>/dev/null & pids+=($!); done
ok=1
for p in "${pids[@]}"; do wait "$p" || ok=0; done
[ $ok -eq 1 ] && [ "$(ci3_head "$d")" = "$c2" ] && pass "concurrent runs on a fresh clone all succeed" \
  || fail "concurrent runs on a fresh clone all succeed" "head=$(ci3_head "$d" 2>&1)"

# Run from an unrelated directory: the script finds its repository from its own location.
d=$(clone_at elsewhere C)
(cd "$work" && "$d/scripts/prep_ci3.sh" 2>/dev/null)
[ "$(ci3_head "$d")" = "$c2" ] && pass "works from any working directory" || fail "works from any working directory"

# `bootstrap.sh init`, the entry point everything calls, with the repository's real bootstrap.sh: it
# prepares ci3 on a fresh clone and stops before the rest of the script, which needs ci3 and tools.
d=$(clone_at init C)
out=$(cd "$d" && ./bootstrap.sh init 2>/dev/null) && rc=0 || rc=$?
if [ $rc -eq 0 ] && [ "$(ci3_head "$d")" = "$c2" ] && [ -z "$out" ]; then
  pass "bootstrap.sh init prepares ci3 and stops, nothing on stdout"
else
  fail "bootstrap.sh init prepares ci3 and stops, nothing on stdout" "rc=$rc head=$(ci3_head "$d" 2>&1) stdout='$out'"
fi

if [ $fails -ne 0 ]; then
  echo "$fails test(s) failed."
  exit 1
fi
echo "All tests passed."
