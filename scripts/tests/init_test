#!/usr/bin/env bash
# Tests `./bootstrap.sh init`, with this repository's bootstrap.sh, against a throwaway superproject
# whose submodules (ci3, another, and one marked update = none) come from local repositories, so no
# network is needed.
set -euo pipefail

bootstrap_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/bootstrap.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Local submodule urls are refused by default (protocol.file.allow); init itself must not need any
# configuration, so allow it through the environment for every git call in this test.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=protocol.file.allow GIT_CONFIG_VALUE_0=always
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
unset root ci3

fails=0
pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1${2:+ ($2)}"; fails=$((fails + 1)); }

# A remote with one commit per argument, each writing that argument to ./file.
function make_remote {
  local name=$1
  shift
  git init -q --bare -b main "$work/$name.git"
  git -C "$work/$name.git" config uploadpack.allowReachableSHA1InWant true
  git clone -q "$work/$name.git" "$work/$name-src" 2>/dev/null
  for v in "$@"; do
    echo "$v" > "$work/$name-src/file"
    git -C "$work/$name-src" add file
    git -C "$work/$name-src" commit -qm "$v"
    git -C "$work/$name-src" push -q origin HEAD:main
  done
}
make_remote ci3 c1 c2
make_remote other o1 o2
make_remote skipped s1
c1=$(git -C "$work/ci3-src" rev-parse HEAD~1) c2=$(git -C "$work/ci3-src" rev-parse HEAD)
o1=$(git -C "$work/other-src" rev-parse HEAD~1) o2=$(git -C "$work/other-src" rev-parse HEAD)

# The superproject. A: ci3 is a plain directory, as before it became a submodule. B: ci3 at c1, other
# at o1, skipped marked update = none. C: ci3 at c2, other at o2.
src="$work/super-src"
git init -q -b main "$src"
cp "$bootstrap_src" "$src/bootstrap.sh"
mkdir "$src/ci3" && echo in-tree > "$src/ci3/file"
git -C "$src" add -A && git -C "$src" commit -qm A && git -C "$src" tag A
git -C "$src" rm -rq ci3
for name in ci3 other skipped; do
  git -C "$src" submodule add -q "file://$work/$name.git" "$name" 2>/dev/null
done
git -C "$src" config -f .gitmodules submodule.skipped.update none
git -C "$src/ci3" checkout -q "$c1" && git -C "$src/other" checkout -q "$o1"
git -C "$src" add -A && git -C "$src" commit -qm B && git -C "$src" tag B
git -C "$src/ci3" checkout -q "$c2" && git -C "$src/other" checkout -q "$o2"
git -C "$src" add -A && git -C "$src" commit -qm C && git -C "$src" tag C

# A fresh clone at a commit, without submodules: what a developer gets.
function clone_at {
  local dir="$work/$1"
  git clone -q --no-recurse-submodules "$src" "$dir"
  git -C "$dir" checkout -q "$2"
  echo "$dir"
}
head_of() { [ -e "$1/.git" ] && git -C "$1" rev-parse HEAD || echo none; }
# Runs init in $1 from that directory; sets rc, and out/err to its stdout/stderr.
function init_in {
  rc=0
  (cd "$1" && ./bootstrap.sh init >"$work/out" 2>"$work/err") || rc=$?
  out=$(cat "$work/out") err=$(cat "$work/err")
}
# stderr without git's "Skipping submodule" notices, which it prints for every update = none
# submodule on every run, even with --quiet.
notices_only() { [ -z "$(grep -v "^Skipping submodule '" <<<"$1")" ]; }
# Clones at B, inits, then checks out C: as after a pull that moved both pins.
function stale_clone {
  local d
  d=$(clone_at "$1" B)
  (cd "$d" && ./bootstrap.sh init 2>/dev/null)
  git -C "$d" checkout -q C
  echo "$d"
}

# A fresh clone gets every submodule at its pin, except update = none, and init stops before the rest
# of bootstrap.sh (which would fail here: no ci3/source, no toolchains). Nothing on stdout: entry
# points run inside pipelines whose stdout is data.
d=$(clone_at fresh C)
init_in "$d"
if [ $rc -eq 0 ] && [ "$(head_of "$d/ci3")" = "$c2" ] && [ "$(head_of "$d/other")" = "$o2" ] &&
  [ "$(head_of "$d/skipped")" = none ] && [ -z "$out" ]; then
  pass "fresh clone: every submodule pulled at its pin, update = none skipped, nothing on stdout"
else
  fail "fresh clone: every submodule pulled at its pin, update = none skipped, nothing on stdout" \
    "rc=$rc ci3=$(head_of "$d/ci3") other=$(head_of "$d/other") skipped=$(head_of "$d/skipped") out='$out' err='$err'"
fi

# Everything at its pin: silent, and no remote needed.
for r in ci3 other; do mv "$work/$r.git" "$work/$r.git.away"; done
init_in "$d"
for r in ci3 other; do mv "$work/$r.git.away" "$work/$r.git"; done
[ $rc -eq 0 ] && [ -z "$out" ] && notices_only "$err" && pass "at the pins: silent apart from skip notices, no network" \
  || fail "at the pins: silent apart from skip notices, no network" "rc=$rc out='$out' err='$err'"

# After a pull moved the pins, the submodules follow.
d=$(stale_clone stale)
init_in "$d"
[ $rc -eq 0 ] && [ "$(head_of "$d/ci3")" = "$c2" ] && [ "$(head_of "$d/other")" = "$o2" ] && [ -z "$out" ] \
  && pass "stale submodules move to their new pins" \
  || fail "stale submodules move to their new pins" "rc=$rc ci3=$(head_of "$d/ci3") other=$(head_of "$d/other") err='$err'"

# Local changes the move would overwrite: git refuses, init fails, and the change survives.
d=$(stale_clone modified)
echo "local edit" > "$d/ci3/file"
init_in "$d"
if [ $rc -ne 0 ] && [ "$(cat "$d/ci3/file")" = "local edit" ] && [[ "$err" == *"would be overwritten"* ]] && [ -z "$out" ]; then
  pass "local changes are never overwritten: init fails and says why"
else
  fail "local changes are never overwritten: init fails and says why" "rc=$rc file=$(cat "$d/ci3/file") err='$err'"
fi

# Opting a submodule out locally, to work in it: init leaves it and updates the rest.
d=$(stale_clone opted_out)
git -C "$d" config submodule.ci3.update none
echo "local edit" > "$d/ci3/file"
init_in "$d"
if [ $rc -eq 0 ] && [ "$(head_of "$d/ci3")" = "$c1" ] && [ "$(cat "$d/ci3/file")" = "local edit" ] &&
  [ "$(head_of "$d/other")" = "$o2" ] && [ -z "$out" ] && [[ "$err" == *"Skipping submodule 'ci3'"* ]]; then
  pass "a submodule opted out with update = none in .git/config is left alone, with a skip notice"
else
  fail "a submodule opted out with update = none in .git/config is left alone, with a skip notice" \
    "rc=$rc ci3=$(head_of "$d/ci3") other=$(head_of "$d/other") err='$err'"
fi

# Untracked files (build output) do not block an update, and survive it.
d=$(stale_clone untracked)
echo "build output" > "$d/other/untracked.out"
init_in "$d"
[ $rc -eq 0 ] && [ "$(head_of "$d/other")" = "$o2" ] && [ -f "$d/other/untracked.out" ] \
  && pass "untracked files do not block an update and are kept" \
  || fail "untracked files do not block an update and are kept" "rc=$rc other=$(head_of "$d/other") err='$err'"

# A commit from before ci3 was a submodule: nothing to do.
d=$(clone_at old A)
init_in "$d"
[ $rc -eq 0 ] && [ "$(cat "$d/ci3/file")" = in-tree ] && [ -z "$out" ] && notices_only "$err" \
  && pass "commit where ci3 is a plain directory: no-op" || fail "commit where ci3 is a plain directory: no-op" "rc=$rc err='$err'"

# Leftovers in a submodule's directory block the init: git refuses, init fails, nothing is touched.
d=$(clone_at leftovers C)
mkdir -p "$d/ci3/__pycache__" && echo x > "$d/ci3/__pycache__/stale.pyc"
init_in "$d"
if [ $rc -ne 0 ] && [ -f "$d/ci3/__pycache__/stale.pyc" ] && [[ "$err" == *"not an empty directory"* ]] && [ -z "$out" ]; then
  pass "leftovers in a submodule directory fail with an explanation and are kept"
else
  fail "leftovers in a submodule directory fail with an explanation and are kept" "rc=$rc err='$err'"
fi

# Run from an unrelated directory: init finds the repository it belongs to.
d=$(clone_at elsewhere C)
(cd "$work" && "$d/bootstrap.sh" init 2>/dev/null)
[ "$(head_of "$d/ci3")" = "$c2" ] && pass "works from any working directory" || fail "works from any working directory"

# A pull that fails: init fails, and git's own output says why.
d=$(clone_at failing C)
mv "$work/other.git" "$work/other.git.away"
init_in "$d"
mv "$work/other.git.away" "$work/other.git"
if [ $rc -ne 0 ] && [[ "$err" == *other.git* ]] && [ -z "$out" ]; then
  pass "a failed pull fails init and shows git's output"
else
  fail "a failed pull fails init and shows git's output" "rc=$rc err='$err'"
fi

if [ $fails -ne 0 ]; then
  echo "$fails test(s) failed."
  exit 1
fi
echo "All tests passed."
