#!/usr/bin/env bash
# Every script that sources ci3 must run scripts/prep_ci3.sh before it does, so that it works on a
# fresh clone and after a pull that moves the ci3 pin.
#
# This applies to every such script, not only to the ones people run directly: scripts are also
# started by other scripts that do not source ci3, by composite actions, by TypeScript tests and by
# globs, so whether a given script is the first to touch ci3 cannot be read off reliably. When ci3
# is already in place, the prep is a no-op of a few milliseconds.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

ci3_source_re='^[[:space:]]*(NO_CD=1[[:space:]]+)?(source|\.)[[:space:]].*ci3/source'

missing=()
count=0
while IFS= read -r f; do
  count=$((count + 1))
  first_source=$(grep -n -E "$ci3_source_re" "$f" | head -1 | cut -d: -f1)
  first_prep=$(grep -n -F "scripts/prep_ci3.sh" "$f" | head -1 | cut -d: -f1 || true)
  if [ -z "$first_prep" ] || [ "$first_prep" -gt "$first_source" ]; then
    missing+=("$f")
  fi
done < <(git grep -l -E "$ci3_source_re" -- . ':!ci3' ':!*.md')

if [ ${#missing[@]} -ne 0 ]; then
  echo "These scripts source ci3 without running scripts/prep_ci3.sh first:"
  printf '  %s\n' "${missing[@]}"
  echo 'Add this line before the line that sources ci3:'
  echo '  "$(git rev-parse --show-toplevel)/scripts/prep_ci3.sh"'
  exit 1
fi
echo "All $count scripts that source ci3 run scripts/prep_ci3.sh first."
