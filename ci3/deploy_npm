#!/usr/bin/env bash
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source

version=$1

dry_run=${DRY_RUN:-0}

# A stable release takes 'latest'; the nightly and rc channels share 'prerelease'; every other
# channel gets a dist-tag of its own. Sharing is a closed set on purpose: a 'commit' canary cut
# from a pull request carries that branch's manifest version, so it can be newer than the newest
# nightly and would otherwise repoint 'prerelease' at an unmerged build. Prerelease versions are
# installed by exact version anyway.
prerelease=$(semver prerelease $version)
channel=${prerelease%%.*}
case "$channel" in
  "") npm_tag="latest" ;;
  nightly | rc) npm_tag="prerelease" ;;
  *) npm_tag="$channel" ;;
esac

# Authenticate npm against NPM_REGISTRY with the credential in the environment.
source $ci3/source_npm_auth

package_name=$(jq -r '.name' package.json)
echo_header "publishing $package_name"

published_version=$(npm show . version --tag $npm_tag 2>/dev/null | grep -vE '^@' || true)

# Check if there is already a published package equal to given version, assume this is a re-run of a deploy.
if [ "$version" == "$published_version" ]; then
  echo "Tagged $npm_tag version $version is equal to published $npm_tag version $published_version."
  echo "Skipping publish."
  exit 0
fi

# A version older than what its dist-tag already points at must not take it: publishing a patch to
# an old release line, or re-running an old tag's workflow, would otherwise repoint 'latest' (or
# 'prerelease', or a channel's own tag) backwards for everyone. Such a version is published with no
# dist-tag at all, which costs nothing: an exact version and a range like '@5' both resolve against
# the published versions and consult no tag.
take_tag=1
if [ -n "$published_version" ] && [ "$(semver sort "$published_version" "$version" | tail -1)" != "$version" ]; then
  take_tag=0
  echo "Version $version is older than the published $npm_tag ($published_version);"
  echo "publishing it without moving '$npm_tag'."
fi

# npm attaches a dist-tag to every publish, so publishing untagged means taking one nothing reads
# and dropping it again. The name carries the version so that a retry of an attempt that died
# between the two steps looks for the same tag, and it is not a bare 'v<major>': npm rejects any
# dist-tag that parses as a semver range, and 'v5' is the range '>=5.0.0 <6.0.0-0'.
tmp_tag="tmp-$version"
if [ "$take_tag" -eq 1 ]; then
  publish_tag=$npm_tag
else
  publish_tag=$tmp_tag
fi

# Create temp directory for publishing
tmpdir=$(mktemp -d)
function cleanup {
  rm -rf "$tmpdir"
}
trap cleanup SIGINT SIGTERM EXIT

# Use npm pack instead of yarn pack. yarn pack fails on portal: dependencies (e.g. bb.js)
# because its beforeWorkspacePacking hook can't resolve workspace:^ for portal links.
# npm pack just packs the files without trying to resolve workspace refs.
npm pack --pack-destination "$tmpdir" --quiet

# Extract and prepare
cd "$tmpdir"
tar -xzf *.tgz
cd package

# Replace workspace:^ with concrete versions.
release_prep_package_json $version

# Publish from temp dir
if [ "$dry_run" -eq 1 ]; then
  denoise "npm publish --ignore-scripts --dry-run --tag $publish_tag --access public"
else
  # Check if version exists.
  if npm view "$package_name@$version" version >/dev/null 2>&1; then
    # Already published, so there is nothing to publish and only a dist-tag to (re)apply.
    if [ "$take_tag" -eq 0 ]; then
      echo "$version is already published and older than $npm_tag ($published_version). Skipping."
      # Only there if an earlier attempt died between publishing and dropping it.
      npm dist-tag rm "$package_name" "$tmp_tag" 2>/dev/null || true
      exit 0
    fi
    # Tag the existing version.
    npm dist-tag add $package_name@$version $npm_tag
  else
    # Publish new version.
    denoise "npm publish --ignore-scripts --tag $publish_tag --access public"
    # Leaving this behind would be the public tag the publish was meant not to create, so a failure
    # here fails the release; the removal above makes the re-run idempotent.
    if [ "$take_tag" -eq 0 ]; then
      npm dist-tag rm "$package_name" "$tmp_tag"
    fi
  fi
fi
