# The release target: where a release reads its packages from, and where it publishes.
#
# Sourced by `bootstrap.sh ci-release` before the build and again by `bootstrap.sh release`, so a
# misconfigured environment fails in seconds instead of after a full build. RELEASE_TARGET is a
# literal in the release workflow, never a GitHub variable, so no variable edit can flip a flow;
# everything else is either supplied by the workflow's environment or derived here.
#
#   public   npmjs + DockerHub, plus the aztec-up and playground assets. release.yml states both
#            URLs as literals rather than GitHub variables, so no variable edit can retarget a
#            public release.
#   private  one GCP Artifact Registry for both the @aztec-foundation reads and the @aztec-labs
#            writes, and nothing public. Its credentials and npm URL come from the release-private
#            environment, its docker URL from the repo-level INTERNAL_DOCKER_REGISTRY the deploy
#            workflows also read.
#
# The two targets share no credential: an environment that can read private packages holds nothing
# that can publish publicly, and vice versa. The assertions here are the backstop for the cases
# GitHub cannot see — a hand-run release, a mis-wired workflow, a half-configured environment.

export RELEASE_TARGET=${RELEASE_TARGET:-public}

# Both URLs are required, whatever the target: an unset value is a configuration error, never a
# silent fall back to a default destination. Exported so ci3/bootstrap_ec2 forwards them to the
# build container however the caller happened to set them.
: "${NPM_REGISTRY:?NPM_REGISTRY is required}"
: "${DOCKER_REGISTRY:?DOCKER_REGISTRY is required}"
export NPM_REGISTRY DOCKER_REGISTRY

case "$RELEASE_TARGET" in
  public)
    export RELEASE_PROJECTS="yarn-project aztec-up playground release-image"

    # Sanity check the registry. NPM_REGISTRY is both where the build reads our scopes from and
    # where it publishes them, so a public release pointed elsewhere would bake private packages
    # into the images it pushes to DockerHub and the assets it uploads to the public buckets.
    if [[ "$NPM_REGISTRY" != *npmjs.org* ]]; then
      echo_stderr "A public release must read and publish npm from npmjs, not $NPM_REGISTRY."
      exit 1
    fi
    ;;
  private)
    # What gets published is code, not configuration: the projects that publish public artifacts
    # (aztec-up, playground) are not in the list, so their release functions are never invoked.
    export RELEASE_PROJECTS="yarn-project release-image"

    # Sanity check the registries.
    if [[ "$NPM_REGISTRY" == *npmjs.org* ]] || [[ "$DOCKER_REGISTRY" == docker.io/* ]]; then
      echo_stderr "A private release must not publish to npmjs or DockerHub ($NPM_REGISTRY, $DOCKER_REGISTRY)."
      exit 1
    fi

    # The credential is required, not just the URL. ci3/source_npm_auth writes its whole
    # configuration only when a credential is set, so a private release without one routes no
    # scope at all: the build resolves @aztec-foundation from npmjs, succeeds, and fails at the
    # publish. Every reader of the private arm publishes, so there is no case to be lenient for.
    : "${NPM_USERNAME:?NPM_USERNAME is required for a private release (INTERNAL_NPM_USERNAME, on release-private)}"
    : "${NPM_PASSWORD:?NPM_PASSWORD is required for a private release (INTERNAL_NPM_PASSWORD, on release-private)}"
    : "${DOCKER_USERNAME:?DOCKER_USERNAME is required for a private release (INTERNAL_DOCKER_USERNAME, on release-private)}"
    : "${DOCKER_PASSWORD:?DOCKER_PASSWORD is required for a private release (INTERNAL_DOCKER_PASSWORD, on release-private)}"

    # These should not be reachable.
    for var in NPM_TOKEN DOCKERHUB_USERNAME DOCKERHUB_PASSWORD; do
      if [ -n "${!var:-}" ]; then
        echo_stderr "$var must not be set for a $RELEASE_TARGET release; it belongs to the other target."
        exit 1
      fi
    done

    # A private release always comes from a private/v* tag, so the channel check below is not
    # optional here: an absent version has nothing to publish under, and skipping the check is
    # how a private build would end up on a public channel.
    if ! semver check "${REF_NAME:-}" >/dev/null 2>&1; then
      echo_stderr "A private release needs REF_NAME to be a version; got '${REF_NAME:-}'."
      exit 1
    fi

    # The private tag carries its own channel, so the version says which flow produced it.
    if semver check "${REF_NAME:-}" >/dev/null 2>&1; then
      release_channel=$(dist_tag)
      if [ "$release_channel" != private ]; then
        echo_stderr "A private release needs a <version>-private.<n> tag; $REF_NAME is '$release_channel'."
        exit 1
      fi
      unset release_channel
    fi

    # The build cache is served over plain HTTP with no credentials (see ci3/cache_download), so
    # anything a private build uploads is publicly downloadable. Exported here rather than set in
    # the workflow so it cannot be forgotten.
    export NO_CACHE_UPLOAD=1
    # Downloads are off for a different reason: no cache key mentions the registry. node_modules is
    # keyed on yarn.lock plus package.json and the release-image base layer on the Dockerfiles plus
    # yarn.lock, all identical between a public and a private build of the same tree, so a private
    # run would restore a public run's entries and skip both installs — publishing artifacts built
    # against npmjs while reporting success.
    export NO_CACHE=1
    ;;
  *)
    echo_stderr "Unknown RELEASE_TARGET '$RELEASE_TARGET' (expected public or private)."
    exit 1
    ;;
esac
