#!/usr/bin/env bash
set -euo pipefail

# @dependency ../../yarn-project/end-to-end/scripts/run_test.sh
root=$(git rev-parse --show-toplevel)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/ci3" "$scratch/bin"
touch "$scratch/ci3/source"
cat > "$scratch/bin/git" <<'EOF'
#!/usr/bin/env bash
echo "$LAUNCHER_TEST_ROOT"
EOF
cat > "$scratch/bin/run_compose_test" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${NAME_POSTFIX:-}"
EOF
chmod +x "$scratch/bin/"*

check() {
  local inherited=$1 name=$2 expected=$3 actual
  actual=$(PATH="$scratch/bin:$PATH" LAUNCHER_TEST_ROOT="$scratch" NAME_POSTFIX="$inherited" \
    bash "$root/yarn-project/end-to-end/scripts/run_test.sh" ha e2e_ha "$name")
  if [[ "$actual" != "$expected" ]]; then
    echo "Expected '$expected', got '$actual'" >&2
    exit 1
  fi
}

check _retry_deadbeef 'Some Test' _retry_deadbeef_some_test
check _retry_second 'Some Test' _retry_second_some_test
check '' 'Some Test' _some_test
check _retry_deadbeef '' _retry_deadbeef
check '' '' ''
echo 'HA retry postfix tests passed'
